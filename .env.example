# Panel -> your Application -> Developer -> API keys.

# Server-only. Grants full API access for this Application. Never commit it.
REKEY_SECRET=rp_live_replace_me
REKEY_URL=https://api.rekey.dev

# Safe in the browser. Identifies the Application; grants nothing on its own.
PUBLIC_REKEY_PUBLIC_KEY=rp_pub_replace_me
PUBLIC_REKEY_URL=https://api.rekey.dev

# Where this app is reachable. Checkout returns the user here, so in production
# it has to be the real origin.
PUBLIC_APP_URL=http://localhost:4321
