# Panel -> your Application -> Developer -> API keys.

# Server-only. Grants full API access for this Application. Never commit it.
REKEY_SECRET=rp_test_replace_me

# Which deployment that key belongs to. Required, with no default: this value
# is where REKEY_SECRET gets sent, so guessing it wrong sends your secret to
# somebody else's host. Rekey Cloud is https://api.rekey.dev, a self-hosted
# deployment is your own public origin, and a local one is http://localhost:3030.
REKEY_URL=https://api.rekey.dev

# Safe in the browser. Identifies the Application; grants nothing on its own.
PUBLIC_REKEY_PUBLIC_KEY=rp_pub_replace_me

# The same deployment as REKEY_URL, browser-visible. Required for the same
# reason: half a configuration pointing at each of two deployments is the
# commonest way to get an API key rejected.
PUBLIC_REKEY_URL=https://api.rekey.dev

# Where this app is reachable. Required, with no default. Checkout builds its
# return URLs from it, so a wrong or missing value takes the buyer's money and
# returns them somewhere dead, and Astro reads it to decide which origin to
# trust for form posts. In production it has to be the real origin.
PUBLIC_APP_URL=http://localhost:4321

# Only set this if you serve the app over plain HTTP on a hostname that is not
# localhost. Otherwise the session cookie is issued with `Secure`, the browser
# refuses it, and sign-in appears to succeed while nobody is ever signed in.
# REKEY_COOKIE_SECURE=false
