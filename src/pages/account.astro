---
import Layout from '../layouts/Layout.astro';
import { rekey } from '../lib/rekey';
import { cancelEffect, isCancelScheduled } from '@rekey.dev/node';

const session = Astro.locals.session;
if (!session) return Astro.redirect('/sign-in?next=/account');

const [subscription, entitlements] = await Promise.all([
  rekey().billing.getSubscription(session.accessToken, { includeEnded: true }).catch(() => null),
  rekey().billing.getEntitlements(session.accessToken).catch(() => null),
]);

// Two different questions:
//   isCancelScheduled -> is this ALREADY scheduled to end?
//   cancelEffect       -> if I cancel NOW, do they keep the rest of the period,
//                         or does access stop on click with no refund?
const alreadyEnding = subscription ? isCancelScheduled(subscription) : false;
const gracefulCancel = subscription ? cancelEffect(subscription) === 'period-end' : false;
const live = subscription?.status === 'ACTIVE' || subscription?.status === 'PAST_DUE';
---

<Layout title="Account">
  <header>
    <h1 class="text-2xl font-medium tracking-tight">Account</h1>
    <p class="mt-1 text-neutral-600 dark:text-neutral-400">{session.user.email}</p>
  </header>

  <section class="mt-8 rounded-xl border border-neutral-200 p-6 dark:border-neutral-800">
    <h2 class="text-sm font-medium uppercase tracking-wider text-neutral-500">Plan</h2>
    {
      live && subscription ? (
        <>
          <p class="mt-3 text-lg">{subscription.status}</p>
          {subscription.currentPeriodEnd && (
            <p class="text-sm text-neutral-600 dark:text-neutral-400">
              {alreadyEnding ? 'Access until' : 'Renews on'}{' '}
              {new Date(subscription.currentPeriodEnd).toLocaleDateString()}
            </p>
          )}
          {alreadyEnding ? (
            <p class="mt-4 text-sm text-neutral-600 dark:text-neutral-400">
              Already set to end. Nothing more to do.
            </p>
          ) : (
            <form method="POST" action="/api/cancel" class="mt-5">
              <button
                type="submit"
                class="rounded-md border border-neutral-300 px-3 py-1.5 text-sm hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-900"
              >
                {gracefulCancel ? 'Cancel at period end' : 'Cancel now'}
              </button>
              <p class="mt-2 text-xs text-neutral-500">
                {gracefulCancel
                  ? 'You keep access until the date above.'
                  : 'This subscription is not ACTIVE, so cancelling ends access immediately with no refund for the remainder.'}
              </p>
            </form>
          )}
        </>
      ) : (
        <div class="mt-3">
          <p class="text-neutral-600 dark:text-neutral-400">
            {subscription ? `Ended (${subscription.status.toLowerCase()}).` : 'No plan yet.'}
          </p>
          <a href="/pricing" class="mt-2 inline-block text-sm underline">
            See plans
          </a>
        </div>
      )
    }
  </section>

  <section class="mt-6 rounded-xl border border-neutral-200 p-6 dark:border-neutral-800">
    <h2 class="text-sm font-medium uppercase tracking-wider text-neutral-500">Credits</h2>
    <p class="mt-3 text-lg tabular-nums">{entitlements?.creditBalance ?? 0}</p>
    <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
      Spent from your server with <code class="font-mono text-xs">rekey().credits.consume()</code>.
      See src/pages/api/use-credit.ts.
    </p>
  </section>
</Layout>
